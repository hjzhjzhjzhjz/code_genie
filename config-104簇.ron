// 104簇-内置字频 云端优化配置（与本地 跑分布修正-104簇-16000w.toml 逐项等价）。
// total_steps / threads 由 optimize workflow 按输入参数改写；
// files 里三个文件位于 inputs-104簇/（workflow 传 files_dir=inputs-104簇 时自动加前缀）。
(
    files: (
        fixed: "字根约束-新聚类.txt",                    // 固定字根与各码位约束
        splits: "单字拆分-星陈-全字集-内置字频.txt",     // 优化用拆分表
        pair_equiv: "",                                  // 留空 = 内嵌当量表
        key_dist: "用指分布.txt",                        // 二轮校准用指分布（总和 100.00）
        full_splits: "",                                 // 不生成完整码表（与本地口径一致）
    ),
    keys: (
        allowed: "qwertyuiopasdfghjklxcvbnm",        // 注意：无 y（与本地一致）
        display_order: "qwertyuiopasdfghjklzxcvbnm",
        termination_keys: "_",
    ),
    weights: (
        full_code: (
            collision_count: 0.05,
            collision_rate: 0.55,
            equivalence: 0.33,
            equiv_cv: 0.06,
            distribution: 0.01,
        ),
        simple_code: (
            enabled: true,
            full_code_weight: 0.4,
            simple_code_weight: 0.6,
            freq: 0.0,
            equiv: 0.75,
            dist: 0.01,
            collision_count: 0.20,
            collision_rate: 0.04,
            simple_start_progress: 0.35,
            simple_ramp_progress: 0.1,
            simple_activation_reheat: 1.0,
            simple_coverage_ratio: 1.0,
            simple_active_coverage: 1.0,
            reconcile_interval_ratio: 0.05,
            simple_assign_mode: "efficiency",
            simple_protect_top_n: 0,
        ),
    ),
    annealing: (
        threads: 3,                        // 由 workflow 改写
        total_steps: 40000000,             // 由 workflow 改写
        temp_start: 0.0003,
        temp_end: 0.00001,
        comfort_progress: 0.5,
        comfort_width: 0.15,
        comfort_slowdown: 0.6,
        swap_probability: 0.35,
        min_improve_steps_ratio: 0.1,
        reheat_factor: 1.0,                // 关闭重热（与本地一致）
        conflict_probability: 0.2,
        conflict_refresh_interval: 1000,
        conflict_sample_window: 20,
        conflict_weight_by_freq: true,
        conflict_key_by_load: true,
        checkpoint_interval_ratio: 0.05,
        full_key_swap_probability: 0.01,
    ),
    simple_levels: [
        (level: 1, code_num: 1, rules: ["Aa"], commit_keys: Some("_")),
        (level: 2, code_num: 1, rules: ["AaBa", "AaAz"], commit_keys: Some("")),
        (level: 3, code_num: 1, rules: ["AaBaCa"], commit_keys: Some("")),
    ],
    targets: Some((
        full_code: (
            enabled: true,
            collision_count: 900.0,
            collision_rate: 0.00015,
            equivalence: 1.23,
            equiv_cv: 0.11,
            distribution: 30.0,
            low_weight: 0.01,
            collision_count_max: 0.0,
            collision_rate_max: 0.0,
            equivalence_max: 0.0,
            equiv_cv_max: 0.0,
            distribution_max: 0.0,
        ),
        simple_code: (
            enabled: true,
            collision_count: 100000.0,
            collision_rate: 1.0,
            freq: 0.10,
            equiv: 2.0,
            dist: 100000.0,
            low_weight: 0.0,
            collision_count_max: 0.0,
            collision_rate_max: 0.0,
            freq_max: 0.0,
            equiv_max: 0.0,
            dist_max: 0.0,
        ),
    )),
    constraints: Some((
        max_encodings: 195,        // 字根键位组合去重种数上限 195
        encoding_penalty: 0.002,
    )),
)
