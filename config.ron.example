// CodeGenie 配置示例（RON 格式）
// 复制为 config.ron 后按需修改，用 `code_genie -c config.ron <子命令>` 加载。
// RON 语法：`(字段: 值, ...)` 结构体、`[..]` 数组、`//` 注释、尾逗号可选。
(
    files: (
        fixed: "字根约束.txt",              // 固定字根与各码位约束
        splits: "单字拆分.txt",             // 优化用拆分表（常用字，快）
        pair_equiv: "pair_equivalence.txt", // 字根对当量表（留空 = 用内嵌当量表）
        key_dist: "key_distribution.txt",   // 用指分布目标（留空 = 用内嵌用指分布）
        full_splits: "moling/拆分全表.txt", // 全量拆分表（留空 = 不生成完整码表）；须与 splits 同一套根名
    ),
    keys: (
        allowed: "qwertyuiopasdfghjklzxcvbnm",       // 允许分配的键位
        display_order: "qwertyuiopasdfghjklzxcvbnm", // 报告里的键位显示顺序
        termination_keys: "_",                       // 全码末键属于这些键时不追加虚拟空格当量
    ),
    weights: (
        full_code: (
            collision_count: 0.19,   // 重码数权重
            collision_rate: 0.3,     // 重码率权重
            equivalence: 0.3,        // 当量权重
            equiv_cv: 0.01,          // 当量变异系数权重
            distribution: 0.2,       // 分布偏差权重
        ),
        simple_code: (
            enabled: true,                 // 是否启用简码优化
            full_code_weight: 0.6,         // 全码目标总权重
            simple_code_weight: 0.4,       // 简码目标总权重
            freq: 0.2,                     // 简码：频率覆盖权重
            equiv: 0.2,                    // 简码：当量权重
            dist: 0.2,                     // 简码：分布偏差权重
            collision_count: 0.1,          // 简码：重码数权重
            collision_rate: 0.3,           // 简码：重码率权重
            simple_start_progress: 0.4,    // 简码计算激活进度阈值
            simple_ramp_progress: 0.1,     // 权重从 0 渐进到目标的进度长度
            simple_activation_reheat: 1.2, // 激活当刻升温倍率
            simple_coverage_ratio: 1.0,    // 候选字累计字频覆盖率阈值
            simple_active_coverage: 0.9,   // 退火期 active 候选覆盖率（≤ coverage_ratio）
            reconcile_interval_ratio: 0.05,// 周期对账间隔比例
            simple_assign_mode: "efficiency", // 桶内出简排序：frequency / efficiency
            simple_protect_top_n: 0,       // 简码占用保护：0 = 保护全部汉字
        ),
    ),
    annealing: (
        threads: 12,                       // 并行线程数
        total_steps: 2000000,              // 总迭代步数
        temp_start: 1.0,                   // 初温（兜底；运行时按初态自动标定）
        temp_end: 0.000001,                // 末温（兜底）
        comfort_progress: 0.5,             // 舒适区在降温曲线上的位置（0~1，0.5 = 正中）
        comfort_width: 0.15,               // 舒适区宽度（高斯 sigma）
        comfort_slowdown: 0.7,             // 舒适区减速因子
        swap_probability: 0.35,            // 交换操作概率
        min_improve_steps_ratio: 0.1,      // 无改进触发重热的步数比例
        perturb_interval_ratio: 0.05,      // 低温扰动间隔比例（0 = 关闭）
        perturb_strength: 0.03,            // 扰动强度（0 = 关闭）
        perturb_trigger_temp_ratio: 0.01,  // 扰动触发阈值 = 舒适区温度 × 本比例
        perturb_temp_multiplier: 2.0,      // 扰动时温度倍率
        perturb_collision_pairs_limit: 10, // 扰动优先采样的冲突对上限
        reheat_factor: 1.3,                // 重热倍率（1.0 = 关闭）
        conflict_probability: 0.2,         // 冲突导向算子概率。代码默认 0.0（关闭）；0.2 是扫参最优，要用就显式打开
        conflict_refresh_interval: 1000,   // 冲突条目重排的兜底间隔（同步次数；编码桶已改为增量维护）
        conflict_sample_window: 20,        // 冲突采样窗口（前 N 个冲突编码；实测 20/25/30 无差异）
        conflict_weight_by_freq: true,     // 冲突排序：false = 按字数；true = 按重码损失（字频和 − 最高字频），优先修高频重码
        conflict_key_by_load: true,        // 落点选键：true = 按键位剩余配额加权（分布更匀，代价重码略升）；false = 均匀随机
        checkpoint_interval_ratio: 0.05,   // checkpoint 间隔（占 total_steps 比例）
        full_key_swap_probability: 0.01,   // 整键互换算子概率（0 = 关闭）
    ),
    simple_levels: [
        (level: 1, code_num: 1, rules: ["Aa"], commit_keys: Some("_")),              // 一级简码
        (level: 2, code_num: 1, rules: ["AaBa"], commit_keys: Some("")),             // 二级简码
        (level: 3, code_num: 0, rules: ["AaAbZz", "AaBaZz"], commit_keys: Some("")), // 0 = 不分配该级
    ],
    targets: Some((
        full_code: (
            enabled: false,            // 目标偏差模式（false = 原线性公式）
            collision_count: 0.0,      // 目标重码数
            collision_rate: 0.0,       // 目标重码率
            equivalence: 0.0,          // 目标当量
            equiv_cv: 0.0,             // 目标当量变异系数
            distribution: 0.0,         // 目标分布偏差
            low_weight: 0.01,          // 已达目标时的持续优化动力
            collision_count_max: 0.0,  // 硬约束（0 = 不启用）
            collision_rate_max: 0.0,
            equivalence_max: 0.0,
            equiv_cv_max: 0.0,
            distribution_max: 0.0,
        ),
        simple_code: (
            enabled: false,
            collision_count: 0.0,
            collision_rate: 0.0,
            freq: 0.0,
            equiv: 0.0,
            dist: 0.0,
            low_weight: 0.01,
            collision_count_max: 0.0,
            collision_rate_max: 0.0,
            freq_max: 0.0,
            equiv_max: 0.0,
            dist_max: 0.0,
        ),
    )),
)
